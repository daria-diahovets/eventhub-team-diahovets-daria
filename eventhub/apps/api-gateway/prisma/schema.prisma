generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SeatStatus {
  FREE
  HELD
  SOLD
}

enum EventStatus {
  SCHEDULED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

model User {
  id              String         @id @default(uuid(7)) @db.Uuid
  email           String         @unique
  passwordHash    String?
  emailVerified   Boolean        @default(false)
  role            Role           @default(USER)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  refreshTokens   RefreshToken[]
  orders          Order[]
  oauthAccounts   OAuthAccount[]
  organizedEvents Event[]        @relation("OrganizedEvents")
}

model OAuthAccount {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @db.Uuid
  provider        String
  providerSubject String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

model Venue {
  id     String  @id @default(uuid(7)) @db.Uuid
  name   String
  city   String
  events Event[]

  @@index([city])
}

model Event {
  id             String      @id @default(uuid(7)) @db.Uuid
  title          String
  description    String?
  category       String
  imageUrl       String?
  status         EventStatus @default(SCHEDULED)
  startsAt       DateTime    @db.Timestamptz(3)
  endsAt         DateTime?   @db.Timestamptz(3)
  minPriceCents  Int
  currency       String      @default("UAH") @db.Char(3)
  availableSeats Int         @default(0)
  venueId        String      @db.Uuid
  organizerId    String?     @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  venue     Venue       @relation(fields: [venueId], references: [id])
  organizer User?       @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: SetNull)
  seats     Seat[]
  orders    Order[]

  @@index([startsAt, id])
  @@index([venueId])
  @@index([organizerId])
}

model Seat {
  id            String     @id @default(uuid(7)) @db.Uuid
  eventId       String     @db.Uuid
  rowLabel      String
  number        Int
  priceCents    Int
  status        SeatStatus @default(FREE)
  holdExpiresAt DateTime?  @db.Timestamptz(3)

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItem OrderItem?

  @@unique([eventId, rowLabel, number])
  @@index([eventId, status])
  @@index([status, holdExpiresAt])
}

model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @db.Uuid
  eventId        String      @db.Uuid
  status         OrderStatus @default(PENDING)
  totalCents     Int
  currency       String      @default("UAH") @db.Char(3)
  holdExpiresAt  DateTime    @db.Timestamptz(3)
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([status, holdExpiresAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id         String @id @default(uuid(7)) @db.Uuid
  orderId    String @db.Uuid
  seatId     String @unique @db.Uuid
  priceCents Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seat  Seat  @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
