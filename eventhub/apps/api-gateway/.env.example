# Порт, на якому слухає api-gateway
PORT=3000

# Джерело, якому дозволено крос-доменні запити (dev-сервер Vite)
WEB_ORIGIN=http://localhost:5173

# Рівень деталізації логів pino: trace|debug|info|warn|error|fatal
LOG_LEVEL=debug

# Підключення до Postgres (docker-compose.yml: порт 5432, user/password postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventhub

# query - логувати кожен SQL-запит Prisma (для пошуку N+1), off - вимкнено
PRISMA_LOG=off

NODE_ENV=development

JWT_ACCESS_SECRET=change-me-generate-your-own-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
